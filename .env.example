# Mock mode is the supported, deterministic default.
MODELLATOR_DATA_MODE=mock
MODELLATOR_DATABASE_PATH=data/modellator.db
MODELLATOR_FRONTEND_ORIGIN=http://localhost:3000
MODELLATOR_DEFAULT_RATE=0.0425
MODELLATOR_DEFAULT_DIVIDEND_YIELD=0.0
MODELLATOR_MOCK_VALUATION_DATETIME=2026-07-31T15:30:00Z

# Frontend default; usually no override is necessary.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Experimental IBKR settings. These do nothing while MODELLATOR_DATA_MODE=mock.
# The official TWS API Python client is installed separately; this optional path is used by
# backend/scripts/install_official_ibkr_api.ps1 and is never consulted in mock mode.
MODELLATOR_IBKR_API_SOURCE=C:\TWS API\source\pythonclient
MODELLATOR_IBKR_HOST=127.0.0.1
MODELLATOR_IBKR_PORT=7497
MODELLATOR_IBKR_CLIENT_ID=9001
MODELLATOR_IBKR_USE_DELAYED=true

# Opt-in read-only diagnostic settings; use a smoke client ID distinct from the application.
MODELLATOR_IBKR_SMOKE_INSTRUMENT=SPY
MODELLATOR_IBKR_SMOKE_SYMBOL=SPY
